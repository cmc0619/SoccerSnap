SOCCERSNAP_DATA_DIR=./data
SOCCERSNAP_DATABASE_URL=sqlite:///./data/soccersnap.db
SOCCERSNAP_DEMO_TEAM_CODE=SNAP26
SOCCERSNAP_HOST=127.0.0.1
SOCCERSNAP_PORT=7420
# Required unique secrets — do not use these placeholder strings in production.
SOCCERSNAP_SECRET_KEY=
